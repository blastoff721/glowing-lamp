{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/Magazine", "destination": "/magazine" }
  ],
  "redirects": [
    { "source": "/checkout", "destination": "/virasat", "permanent": false },
    { "source": "/faliure", "destination": "/virasat", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
